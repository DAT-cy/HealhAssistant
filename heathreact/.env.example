# ============================================================
# Health Assistant API Configuration
# ============================================================

# Docker backend is published on host port 8084; Android emulator uses 10.0.2.2 for the host.
# Physical device: use the host LAN IP. Web/iOS simulator: use localhost.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8084

# Public OAuth client IDs from the same Google Cloud project. Native Google Sign-In requires an EAS/dev build.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Optional: Frappe site URL (không có dấu / cuối)
# Chỉ cần cấu hình nếu dùng các service Frappe cũ.
EXPO_PUBLIC_FRAPPE_SITE_URL=https://your-site.erpnext.com
