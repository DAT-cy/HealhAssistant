# ============================================================
# Health Assistant API Configuration
# ============================================================

# Android emulator: 10.0.2.2 trỏ về máy tính host.
# Điện thoại thật: thay bằng IPv4 LAN của máy chạy backend, ví dụ http://192.168.1.20:8080.
# iOS simulator: thường dùng http://localhost:8080.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# Optional: Frappe site URL (không có dấu / cuối)
# Chỉ cần cấu hình nếu dùng các service Frappe cũ.
EXPO_PUBLIC_FRAPPE_SITE_URL=https://your-site.erpnext.com
