{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to React Native Packager",
      "cwd": "${workspaceFolder}",
      "type": "reactnative",
      "request": "attach"
    },
    {
      "name": "Debug Android (Expo)",
      "cwd": "${workspaceFolder}",
      "type": "reactnative",
      "request": "launch",
      "platform": "android",
      "target": "emulator"
    },
    {
      "name": "Debug iOS (Expo)",
      "cwd": "${workspaceFolder}",
      "type": "reactnative",
      "request": "launch",
      "platform": "ios",
      "target": "simulator"
    }
  ]
}
