{
  "expo": {
    "name": "base-reactnative-tuan",
    "slug": "base-reactnative-tuan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "basereactnativetuan",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.healthassistant.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.healthassistant.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#080C11",
          "dark": {
            "backgroundColor": "#080C11"
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cho phép ứng dụng chụp ảnh bữa ăn để nhận góp ý.",
          "photosPermission": "Cho phép ứng dụng chọn ảnh bữa ăn để nhận góp ý."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Health Assistant mở camera khi bạn chủ động dùng hướng dẫn tập.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép Health Assistant dùng vị trí khi bạn chủ động theo dõi chạy bộ hoặc đi bộ để ước tính quãng đường."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Cho phép Health Assistant đọc bộ đếm bước chân trong lúc bạn theo dõi hoạt động."
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "frappeSiteUrl": "https://your-site.erpnext.com"
    }
  }
}
