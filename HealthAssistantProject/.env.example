# Docker MySQL
MYSQL_ROOT_PASSWORD=1234
MYSQL_DATABASE=health_assistant
MYSQL_PORT=3306

# Spring Boot local profile
DB_URL=jdbc:mysql://localhost:3306/health_assistant?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=1234
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION=86400000

# Gemini API (optional; key chỉ dùng trong backend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=30s

# Cloudinary image uploads (backend only)
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
