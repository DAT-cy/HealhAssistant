# Docker MySQL
MYSQL_ROOT_PASSWORD=1234
MYSQL_DATABASE=health_assistant
MYSQL_PORT=3306

# Docker Compose host ports
BACKEND_HOST_PORT=8084

# Spring Boot local profile
DB_URL=jdbc:mysql://localhost:3306/health_assistant?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=1234
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION=86400000

# Comma-separated accepted Google OAuth client IDs (Web, Android, iOS) for verifying ID token audiences.
GOOGLE_OAUTH_CLIENT_IDS=

# Gemini API (optional; key chỉ dùng trong backend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=30s

# Cloudinary image uploads (backend only)
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OTP email delivery (Gmail requires an App Password when 2-step verification is enabled)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_SECRET=replace-with-a-random-server-secret

# Billing sandbox credentials; never expose these to the mobile app.
BILLING_MODE=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
BILLING_RETURN_URL=http://localhost:8084/api/v1/billing/return
