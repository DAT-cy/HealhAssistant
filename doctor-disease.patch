+import { apiClient } from '../client';
+import { apiVersion } from '@/config/api.config';
+import { mockEnabled } from '../mock';
+import { diseaseMock } from '../mock/disease.mock';
+
+// Contract: docs/api-contract-doctor-disease.md (mục 3).
+export type DiseaseGroup = 'CARDIOVASCULAR' | 'METABOLIC' | 'MUSCULOSKELETAL' | 'RESPIRATORY' | 'NEUROLOGICAL' | 'OTHER';
+export type DiseaseSeverity = 'LOW' | 'MEDIUM' | 'HIGH';
+export type DiseaseReviewFilter = 'ALL' | 'REQUIRED' | 'AUTO';
+
+export interface Disease {
+  id: number;
+  code: string;
+  name: string;
+  group: DiseaseGroup;
+  severity: DiseaseSeverity;
+  description: string | null;
+  symptoms: string[];
+  /** Nên làm */
+  shouldDo: string[];
+  /** Cần tránh */
+  shouldAvoid: string[];
+  notes: string | null;
+  /** true: lộ trình của người dùng có bệnh này phải chờ bác sĩ duyệt */
+  requiresDoctorReview: boolean;
+  active: boolean;
+  /** Số tài liệu Knowledge Base gắn với bệnh */
+  documentCount: number;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export type DiseaseInput = Pick<Disease,
+  'code' | 'name' | 'group' | 'severity' | 'description' | 'symptoms' | 'shouldDo' | 'shouldAvoid' | 'notes' | 'requiresDoctorReview' | 'active'>;
+
+export interface DiseaseStats { total: number; requiresReview: number; autoApproved: number; inactive: number }
+
+export interface DiseaseListParams {
+  q?: string;
+  group?: DiseaseGroup | 'ALL';
+  review?: DiseaseReviewFilter;
+  includeInactive?: boolean;
+}
+
+export const DISEASE_GROUPS: { value: DiseaseGroup; label: string }[] = [
+  { value: 'CARDIOVASCULAR', label: 'Tim mạch' },
+  { value: 'METABOLIC', label: 'Chuyển hoá' },
+  { value: 'MUSCULOSKELETAL', label: 'Cơ xương khớp' },
+  { value: 'RESPIRATORY', label: 'Hô hấp' },
+  { value: 'NEUROLOGICAL', label: 'Thần kinh' },
+  { value: 'OTHER', label: 'Khác' },
+];
+
+export const DISEASE_SEVERITIES: { value: DiseaseSeverity; label: string }[] = [
+  { value: 'LOW', label: 'Nhẹ' },
+  { value: 'MEDIUM', label: 'Trung bình' },
+  { value: 'HIGH', label: 'Nặng' },
+];
+
+export const diseaseGroupLabel = (value: string) => DISEASE_GROUPS.find((item) => item.value === value)?.label ?? value;
+export const diseaseSeverityLabel = (value: string) => DISEASE_SEVERITIES.find((item) => item.value === value)?.label ?? value;
+
+const path = `${apiVersion}/admin/diseases`;
+
+function toQuery(params: DiseaseListParams) {
+  const search = new URLSearchParams();
+  if (params.q) search.set('q', params.q);
+  if (params.group && params.group !== 'ALL') search.set('group', params.group);
+  if (params.review && params.review !== 'ALL') search.set('review', params.review);
+  if (params.includeInactive) search.set('includeInactive', 'true');
+  const text = search.toString();
+  return text ? `?${text}` : '';
+}
+
+const api = {
+  list: (params: DiseaseListParams = {}) => apiClient.request<Disease[]>(`${path}${toQuery(params)}`),
+  stats: () => apiClient.request<DiseaseStats>(`${path}/stats`),
+  get: (id: number) => apiClient.request<Disease>(`${path}/${id}`),
+  create: (input: DiseaseInput) => apiClient.request<Disease>(path, { method: 'POST', body: JSON.stringify(input) }),
+  update: (id: number, input: DiseaseInput) => apiClient.request<Disease>(`${path}/${id}`, { method: 'PUT', body: JSON.stringify(input) }),
+  setReviewRequirement: (id: number, requiresDoctorReview: boolean) =>
+    apiClient.request<Disease>(`${path}/${id}/review-requirement`, { method: 'PATCH', body: JSON.stringify({ requiresDoctorReview }) }),
+  deactivate: (id: number) => apiClient.request<boolean>(`${path}/${id}`, { method: 'DELETE' }),
+};
+
+export const diseaseAdminService: typeof api = mockEnabled ? diseaseMock : api;
