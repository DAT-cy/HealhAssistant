+
+        <View style={styles.notice}>
+          <Ionicons name="information-circle-outline" size={19} color="#0369A1" />
+          <Text style={styles.noticeText}>
+            Lộ trình của người dùng sẽ chờ bác sĩ duyệt nếu họ có bệnh bật “Cần bác sĩ duyệt”, hoặc khai báo bệnh chưa có trong danh mục.
+            {mockEnabled ? ' · Đang dùng dữ liệu mẫu (mock).' : ''}
+          </Text>
+        </View>
+
+        <View style={styles.searchBox}>
+          <Ionicons name="search-outline" size={18} color="#64748B" />
+          <TextInput value={searchDraft} onChangeText={setSearchDraft} placeholder="Tìm theo tên, mã hoặc mô tả" placeholderTextColor="#94A3B8" style={styles.searchInput} returnKeyType="search" />
+          {searchDraft.length > 0 ? <Pressable onPress={() => setSearchDraft('')} accessibilityLabel="Xoá tìm kiếm"><Ionicons name="close-circle" size={18} color="#94A3B8" /></Pressable> : null}
+        </View>
