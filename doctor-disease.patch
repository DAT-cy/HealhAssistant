diff --git a/heathreact/src/api/mock/disease.mock.ts b/heathreact/src/api/mock/disease.mock.ts
new file mode 100644
index 0000000..55ed87a
--- /dev/null
+++ b/heathreact/src/api/mock/disease.mock.ts
@@ -0,0 +1,146 @@
+import type {
+  Disease,
+  DiseaseInput,
+  DiseaseListParams,
+  DiseaseStats,
+} from '../services/disease.service';
+import { createMockStore, mockDelay, mockError } from './index';
+
+const now = () => new Date().toISOString();
+
+const seed = (): Disease[] => {
+  const created = now();
+  const base = { createdAt: created, updatedAt: created, active: true, documentCount: 0, notes: null };
+  return [
+    {
+      ...base, id: 1, code: 'HYPERTENSION', name: 'Tăng huyết áp', group: 'CARDIOVASCULAR', severity: 'MEDIUM',
+      description: 'Huyết áp tâm thu ≥ 140 mmHg hoặc tâm trương ≥ 90 mmHg kéo dài.',
+      symptoms: ['Đau đầu', 'Chóng mặt', 'Hồi hộp'],
+      shouldDo: ['Đi bộ nhanh 30 phút/ngày', 'Giảm muối < 5 g/ngày', 'Đo huyết áp trước khi tập'],
+      shouldAvoid: ['Nín thở khi nâng tạ (Valsalva)', 'Tập cường độ rất cao đột ngột'],
+      requiresDoctorReview: true, documentCount: 2,
+    },
+    {
+      ...base, id: 2, code: 'DIABETES_T2', name: 'Đái tháo đường type 2', group: 'METABOLIC', severity: 'MEDIUM',
+      description: 'Rối loạn chuyển hoá glucose do đề kháng insulin.',
+      symptoms: ['Khát nhiều', 'Tiểu nhiều', 'Mệt mỏi'],
+      shouldDo: ['Ăn đúng giờ, chia nhỏ bữa', 'Tập aerobic + kháng lực xen kẽ', 'Mang theo đồ ngọt khi tập'],
+      shouldAvoid: ['Tập khi đường huyết < 5,5 mmol/L chưa ăn', 'Đồ uống có đường'],
+      requiresDoctorReview: true, documentCount: 1,
+    },
+    {
+      ...base, id: 3, code: 'LOW_BACK_PAIN', name: 'Đau thắt lưng mạn tính', group: 'MUSCULOSKELETAL', severity: 'LOW',
+      description: 'Đau vùng thắt lưng kéo dài trên 12 tuần, không có dấu hiệu cảnh báo.',
+      symptoms: ['Đau âm ỉ vùng lưng dưới', 'Cứng lưng buổi sáng'],
+      shouldDo: ['Bài tập cơ lõi (plank, bird-dog)', 'Đi bộ nhẹ', 'Giãn cơ đùi sau'],
+      shouldAvoid: ['Gập lưng nâng vật nặng', 'Ngồi liên tục quá 1 giờ'],
+      requiresDoctorReview: false,
+    },
+    {
+      ...base, id: 4, code: 'ASTHMA', name: 'Hen phế quản', group: 'RESPIRATORY', severity: 'MEDIUM',
+      description: 'Viêm mạn tính đường thở, co thắt phế quản khi gặp tác nhân.',
+      symptoms: ['Khó thở', 'Khò khè', 'Ho về đêm'],
+      shouldDo: ['Khởi động kỹ 10–15 phút', 'Mang thuốc cắt cơn khi tập'],
+      shouldAvoid: ['Tập ngoài trời khi không khí lạnh, ô nhiễm'],
+      requiresDoctorReview: true,
+    },
+    {
+      ...base, id: 5, code: 'OBESITY', name: 'Béo phì', group: 'METABOLIC', severity: 'LOW',
+      description: 'BMI ≥ 25 (chuẩn châu Á).',
+      symptoms: [],
+      shouldDo: ['Tăng vận động dần', 'Thâm hụt năng lượng vừa phải'],
+      shouldAvoid: ['Chạy bật nhảy cường độ cao khi mới bắt đầu'],
+      requiresDoctorReview: false,
+    },
+  ];
+};
+
+const store = createMockStore<Disease>('diseases', seed);
+
+const normalize = (value: string) => value.normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/gi, 'd').toLowerCase().trim();
+
+function validate(input: DiseaseInput, items: Disease[], selfId?: number) {
+  const errors: Record<string, string> = {};
+  if (items.some((item) => item.id !== selfId && item.code.toUpperCase() === input.code.toUpperCase())) errors.code = 'Mã bệnh đã tồn tại.';
+  if (items.some((item) => item.id !== selfId && normalize(item.name) === normalize(input.name))) errors.name = 'Tên bệnh đã tồn tại.';
+  if (Object.keys(errors).length) mockError(400, 'Dữ liệu không hợp lệ.', errors);
+}
+
+export const diseaseMock = {
+  async list(params: DiseaseListParams = {}): Promise<Disease[]> {
+    await mockDelay();
+    const q = normalize(params.q ?? '');
+    return (await store.all())
+      .filter((item) => (params.includeInactive ? true : item.active))
+      .filter((item) => !params.group || params.group === 'ALL' || item.group === params.group)
+      .filter((item) => !params.review || params.review === 'ALL' || (params.review === 'REQUIRED') === item.requiresDoctorReview)
+      .filter((item) => !q || normalize(`${item.name} ${item.code} ${item.description ?? ''}`).includes(q))
+      .sort((a, b) => Number(b.active) - Number(a.active) || a.name.localeCompare(b.name, 'vi'));
+  },
+
+  async stats(): Promise<DiseaseStats> {
+    await mockDelay(200);
+    const items = await store.all();
+    const active = items.filter((item) => item.active);
+    return {
+      total: active.length,
+      requiresReview: active.filter((item) => item.requiresDoctorReview).length,
+      autoApproved: active.filter((item) => !item.requiresDoctorReview).length,
+      inactive: items.length - active.length,
+    };
+  },
+
+  async get(id: number): Promise<Disease> {
+    await mockDelay(200);
+    const found = (await store.all()).find((item) => item.id === id);
+    if (!found) mockError(404, 'Không tìm thấy bệnh.');
+    return found;
+  },
+
+  async create(input: DiseaseInput): Promise<Disease> {
+    await mockDelay();
+    const items = await store.all();
+    validate(input, items);
+    const created: Disease = {
+      ...input,
+      code: input.code.toUpperCase(),
+      id: Math.max(0, ...items.map((item) => item.id)) + 1,
+      documentCount: 0,
+      createdAt: now(),
+      updatedAt: now(),
+    };
+    await store.save([...items, created]);
+    return created;
+  },
+
+  async update(id: number, input: DiseaseInput): Promise<Disease> {
+    await mockDelay();
+    const items = await store.all();
+    const current = items.find((item) => item.id === id);
+    if (!current) mockError(404, 'Không tìm thấy bệnh.');
+    validate(input, items, id);
+    const updated: Disease = { ...current, ...input, code: input.code.toUpperCase(), updatedAt: now() };
+    await store.save(items.map((item) => (item.id === id ? updated : item)));
+    return updated;
+  },
+
+  async setReviewRequirement(id: number, requiresDoctorReview: boolean): Promise<Disease> {
+    await mockDelay(200);
+    const items = await store.all();
+    const current = items.find((item) => item.id === id);
+    if (!current) mockError(404, 'Không tìm thấy bệnh.');
+    const updated: Disease = { ...current, requiresDoctorReview, updatedAt: now() };
+    await store.save(items.map((item) => (item.id === id ? updated : item)));
+    return updated;
+  },
+
+  async deactivate(id: number): Promise<boolean> {
+    await mockDelay();
+    const items = await store.all();
+    if (!items.some((item) => item.id === id)) mockError(404, 'Không tìm thấy bệnh.');
+    await store.save(items.map((item) => (item.id === id ? { ...item, active: false, updatedAt: now() } : item)));
+    return true;
+  },
+
+  reset: () => store.reset(),
+};
diff --git a/heathreact/src/api/mock/index.ts b/heathreact/src/api/mock/index.ts
new file mode 100644
index 0000000..347f0d6
--- /dev/null
+++ b/heathreact/src/api/mock/index.ts
@@ -0,0 +1,52 @@
+import AsyncStorage from '@react-native-async-storage/async-storage';
+import { ApiError } from '../client';
+
+/**
+ * Mock layer cho các API backend CHƯA có (Doctor, danh mục bệnh lý...).
+ * Bật bằng EXPO_PUBLIC_USE_MOCK=true trong .env. Khi backend xong, đặt false:
+ * service sẽ gọi API thật theo đúng contract trong docs/api-contract-doctor-disease.md.
+ */
+export const mockEnabled = process.env.EXPO_PUBLIC_USE_MOCK === 'true';
+
+/** Token giả cho tài khoản chỉ tồn tại trong mock (ví dụ bác sĩ). */
+export const MOCK_TOKEN_PREFIX = 'mock-';
+
+export function isMockToken(token: string | null | undefined) {
+  return Boolean(token && token.startsWith(MOCK_TOKEN_PREFIX));
+}
+
+/** Giả lập độ trễ mạng để thấy trạng thái loading như khi gọi API thật. */
+export async function mockDelay(ms = 350) {
+  await new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+export function mockError(statusCode: number, message: string, validationErrors: Record<string, string> = {}): never {
+  throw new ApiError(statusCode, 'MOCK-ERR', message, validationErrors);
+}
+
+/** Lưu dữ liệu mock vào AsyncStorage (web dùng localStorage) để reload không mất. */
+export function createMockStore<T>(key: string, seed: () => T[]) {
+  let cache: T[] | null = null;
+  const storageKey = `mock:${key}`;
+
+  return {
+    async all(): Promise<T[]> {
+      if (cache) return cache;
+      try {
+        const raw = await AsyncStorage.getItem(storageKey);
+        cache = raw ? (JSON.parse(raw) as T[]) : seed();
+      } catch {
+        cache = seed();
+      }
+      return cache;
+    },
+    async save(items: T[]) {
+      cache = items;
+      try { await AsyncStorage.setItem(storageKey, JSON.stringify(items)); } catch { /* bỏ qua: vẫn còn trong bộ nhớ */ }
+    },
+    async reset() {
+      cache = seed();
+      try { await AsyncStorage.removeItem(storageKey); } catch { /* bỏ qua */ }
+    },
+  };
+}
