+
+        <View style={styles.statsRow}>
+          <Stat label="Đang dùng" value={statsQuery.data?.total} color="#0F766E" />
+          <Stat label="Cần BS duyệt" value={statsQuery.data?.requiresReview} color="#B45309" />
