@@ -0,0 +1,9 @@
+import type { Href } from 'expo-router';
+import type { Role } from '@/api/types';
+
+/** Trang chủ theo role. Dùng chung cho index, login, welcome và các layout guard. */
+export function homeRouteForRole(role: Role | null): Href {
+  if (role === 'ROLE_ADMIN') return '/admin/knowledge';
+  if (role === 'ROLE_DOCTOR') return '/doctor';
+  return '/(user)';
+}
