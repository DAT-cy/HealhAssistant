+
+const PRIMARY = palette.primary;
+const QUERY_KEY = ['admin', 'diseases'] as const;
+
+const REVIEW_FILTERS: { value: DiseaseReviewFilter; label: string }[] = [
+  { value: 'ALL', label: 'Tất cả' },
+  { value: 'REQUIRED', label: 'Cần bác sĩ duyệt' },
+  { value: 'AUTO', label: 'Tự động' },
+];
+
+const schema = z.object({
+  code: z.string().trim().min(2, 'Mã tối thiểu 2 ký tự.').max(40, 'Mã tối đa 40 ký tự.')
+    .regex(/^[A-Za-z0-9_]+$/, 'Chỉ dùng chữ không dấu, số và dấu gạch dưới.'),
+  name: z.string().trim().min(2, 'Nhập tên bệnh.').max(120, 'Tên tối đa 120 ký tự.'),
+  group: z.enum(['CARDIOVASCULAR', 'METABOLIC', 'MUSCULOSKELETAL', 'RESPIRATORY', 'NEUROLOGICAL', 'OTHER']),
+  severity: z.enum(['LOW', 'MEDIUM', 'HIGH']),
+  description: z.string().max(2000, 'Mô tả tối đa 2000 ký tự.'),
+  symptoms: z.string().max(2000),
+  shouldDo: z.string().max(4000),
+  shouldAvoid: z.string().max(4000),
+  notes: z.string().max(2000),
+  requiresDoctorReview: z.boolean(),
+  active: z.boolean(),
+}).refine((value) => toLines(value.shouldDo).length + toLines(value.shouldAvoid).length > 0, {
+  path: ['shouldDo'],
+  message: 'Nhập ít nhất một mục “Nên làm” hoặc “Cần tránh” để AI có dữ liệu.',
+});
+type DiseaseForm = z.infer<typeof schema>;
+
+const emptyForm: DiseaseForm = {
+  code: '', name: '', group: 'OTHER', severity: 'LOW', description: '', symptoms: '', shouldDo: '', shouldAvoid: '', notes: '',
+  requiresDoctorReview: false, active: true,
+};
+
+function toLines(text: string) {
+  return text.split('\n').map((line) => line.replace(/^[-•*]\s*/, '').trim()).filter(Boolean);
+}
+function toForm(disease: Disease): DiseaseForm {
+  return {
+    code: disease.code, name: disease.name, group: disease.group, severity: disease.severity,
+    description: disease.description ?? '', symptoms: disease.symptoms.join('\n'), shouldDo: disease.shouldDo.join('\n'),
+    shouldAvoid: disease.shouldAvoid.join('\n'), notes: disease.notes ?? '',
+    requiresDoctorReview: disease.requiresDoctorReview, active: disease.active,
+  };
+}
+function toInput(form: DiseaseForm): DiseaseInput {
+  return {
+    code: form.code.trim().toUpperCase(), name: form.name.trim(), group: form.group, severity: form.severity,
