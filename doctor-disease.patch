+
+type IconName = React.ComponentProps<typeof Ionicons>['name'];
+
+/** Header dùng chung cho khu vực Admin / Doctor. */
+export function AreaHeader({ icon, identity, onLogout }: { icon: IconName; identity: string; onLogout: () => void }) {
+  const insets = useSafeAreaInsets();
+  return (
+    <View style={[styles.header, { paddingTop: insets.top + 8 }]}>
+      <View style={styles.brandIcon}><Ionicons name={icon} size={20} color={palette.primary} /></View>
+      <View style={styles.headerCopy}>
+        <Text style={styles.brand}>HEALTH ASSISTANT</Text>
+        <Text style={styles.identity} numberOfLines={1}>{identity}</Text>
+      </View>
+      <Pressable onPress={onLogout} style={styles.logoutButton} accessibilityRole="button" accessibilityLabel="Đăng xuất">
+        <Ionicons name="log-out-outline" size={20} color="#475569" />
+      </Pressable>
+    </View>
+  );
+}
+
+export interface AreaTab { href: Href; label: string; icon: IconName; activeIcon: IconName }
+
+/** Thanh tab dưới cùng; tab được chọn theo pathname hiện tại. */
+export function AreaTabBar({ tabs, roleLabel }: { tabs: AreaTab[]; roleLabel: string }) {
+  const insets = useSafeAreaInsets();
+  const pathname = usePathname();
+  return (
+    <View style={[styles.footer, { paddingBottom: Math.max(insets.bottom, 8) }]} accessibilityRole="tablist">
+      {tabs.map((tab) => {
+        const active = pathname === String(tab.href);
+        return (
+          <Pressable
+            key={String(tab.href)}
+            onPress={() => { if (!active) router.replace(tab.href); }}
+            style={styles.tab}
+            accessibilityRole="tab"
+            accessibilityState={{ selected: active }}
+          >
+            <Ionicons name={active ? tab.activeIcon : tab.icon} size={20} color={active ? palette.primary : '#94A3B8'} />
+            <Text style={[styles.tabText, active && styles.tabTextActive]}>{tab.label}</Text>
+          </Pressable>
+        );
+      })}
+      <Text style={styles.role}>{roleLabel}</Text>
+    </View>
+  );
+}
+
+export const ADMIN_TABS: AreaTab[] = [
+  { href: '/admin/knowledge', label: 'Kho tri thức', icon: 'library-outline', activeIcon: 'library' },
+  { href: '/admin/diseases', label: 'Bệnh lý', icon: 'medkit-outline', activeIcon: 'medkit' },
+];
+
+const styles = StyleSheet.create({
+  header: { minHeight: 68, paddingHorizontal: 16, paddingBottom: 10, flexDirection: 'row', alignItems: 'center', gap: 11, backgroundColor: '#FFFFFF', borderBottomWidth: StyleSheet.hairlineWidth, borderBottomColor: '#DCE4E0' },
+  brandIcon: { width: 38, height: 38, borderRadius: 12, alignItems: 'center', justifyContent: 'center', backgroundColor: palette.primarySoft },
+  headerCopy: { flex: 1 },
+  brand: { color: palette.text, fontSize: 11, fontWeight: '800' },
+  identity: { marginTop: 3, color: palette.textMuted, fontSize: 11 },
+  logoutButton: { width: 40, height: 40, borderRadius: 12, alignItems: 'center', justifyContent: 'center', backgroundColor: '#EEF0F8' },
+  footer: { minHeight: 58, paddingTop: 6, paddingHorizontal: 12, flexDirection: 'row', alignItems: 'center', gap: 4, backgroundColor: '#FFFFFF', borderTopWidth: 1, borderTopColor: '#E2E8F0' },
+  tab: { minWidth: 76, paddingHorizontal: 8, paddingVertical: 4, alignItems: 'center', gap: 2 },
+  tabText: { color: '#94A3B8', fontSize: 11, fontWeight: '600' },
